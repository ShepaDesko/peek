[Unit]
Description=Peek — ephemeral secret sharing
Documentation=https://github.com/ShepaDesko/peek
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=peek
Group=peek
ExecStart=/usr/bin/peek serve --config /etc/peek/peek.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3s

# Structured JSON logs on stdout, picked up by journald.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=peek

# --- Hardening (verify with: systemd-analyze security peek) -----------------
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/peek /var/backups/peek
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

# Peek listens above 1024 by default. To bind 80 or 443 directly, uncomment
# both lines below; everything else stays as it is.
# CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# AmbientCapabilities=CAP_NET_BIND_SERVICE

# Resource guard rails.
LimitNOFILE=65535
TasksMax=4096

[Install]
WantedBy=multi-user.target
