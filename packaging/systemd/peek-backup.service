[Unit]
Description=Peek scheduled backup
Documentation=https://github.com/ShepaDesko/peek
After=peek.service

[Service]
Type=oneshot
User=peek
Group=peek
ExecStart=/usr/bin/peek backup --config /etc/peek/peek.toml
SyslogIdentifier=peek-backup

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/peek /var/backups/peek
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectClock=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
UMask=0077
